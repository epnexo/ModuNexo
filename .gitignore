node_modules/
.env
dist/
build/
.next/
# A module change builds into a directory of its own (and a tsconfig for it); see packages/core/src/install/dist.ts
.next-*/
tsconfig.next-*.json
next-env.d.ts

# Written by "npm run registry:generate" from the modules enabled in the database.
apps/web/src/generated/
*.tsbuildinfo

# Installed modules are unpacked here and are not tracked.
modules/*
!modules/.gitkeep

# What the platform receives and unpacks: module archives and their staging trees.
var/

# Agent tooling state generated on this machine
.atl/

# Routes written for installed modules (the demo module "hello" included); never part of the platform.
apps/web/src/app/(shell)/hello/
apps/web/src/app/(shell)/agenda/
apps/web/src/app/(shell)/assistant/
apps/web/src/app/(shell)/contacts/
apps/web/src/app/(shell)/hooks/
apps/web/src/app/(shell)/inbox/
apps/web/src/app/(shell)/pipeline/
apps/web/src/app/(shell)/svc/

# Modules are made outside the platform and installed as archives (modules pack, modules add).
modules-src/

# Working notes of the maintainer (feature logs with the owner's own words). Kept locally, never published.
odd/
