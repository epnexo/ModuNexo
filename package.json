{
  "name": "modunexo-platform",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "workspaces": ["packages/*", "modules/*", "apps/*"],
  "scripts": {
    "test": "node --env-file-if-exists=.env --import tsx --test \"packages/*/test/**/*.test.ts\" \"apps/*/test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck -w @modunexo/web",
    "db:migrate": "node --env-file-if-exists=.env --import tsx packages/core/src/cli/index.ts db:migrate",
    "modunexo": "node --env-file-if-exists=.env --import tsx packages/core/src/cli/index.ts",
    "epnexo": "npm run modunexo --",
    "modules": "node --env-file-if-exists=.env --import tsx packages/core/src/cli/index.ts modules",
    "web:dev": "node --env-file-if-exists=.env --import tsx apps/web/scripts/run.ts dev",
    "web:build": "node --env-file-if-exists=.env --import tsx apps/web/scripts/run.ts build",
    "web:start": "node --env-file-if-exists=.env --import tsx apps/web/scripts/run.ts start",
    "registry:generate": "node --env-file-if-exists=.env --import tsx packages/core/src/cli/index.ts registry:generate"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
